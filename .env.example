# SigNoz Cloud Configuration
# Copy this file to .env and fill in your values

# Full OTLP endpoint URL
# For SigNoz Cloud (US):
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443/v1/traces
# For SigNoz Cloud (EU): https://ingest.eu.signoz.cloud:443/v1/traces
# For SigNoz Cloud (India): https://ingest.in.signoz.cloud:443/v1/traces
# For local testing: http://localhost:4318/v1/traces

# OTLP headers (OpenTelemetry standard env var)
# Format: key1=value1,key2=value2
# For SigNoz Cloud, include your ingestion key:
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=your-ingestion-key-here

# Optional: trace-specific headers (overrides OTEL_EXPORTER_OTLP_HEADERS if same key exists)
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=signoz-ingestion-key=your-ingestion-key-here
